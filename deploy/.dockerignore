# Fairwave deploy/.dockerignore
#
# Applies to builds whose context is deploy/ (open5gs + srsran images,
# see docker-compose.yml). The control-plane image builds from the repo root
# (context: ..) - consider adding a matching root-level .dockerignore so the
# whole repo is not shipped as build context.

.git
.gitignore
**/*.md
docs/
design/
website/
apps/
hw/
sim/
core/

# Other deployment trees - not needed by the lab images
helm/
ansible/
terraform/

# Secrets and local state (defense in depth; see sim/.gitignore, core/.gitignore)
**/*.key
**/*.pem
**/data/
**/tx-ack
**/country
*.env
