[Unit]
Description=Fairwave control plane
Documentation=https://github.com/fairwave/fairwave
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fairwave
Group=fairwave
# Secrets (tokens, wg keys) come ONLY from this env file - mode 0600,
# provisioned at first boot; never baked into the image.
EnvironmentFile=/etc/fairwave/env
ExecStart=/usr/local/bin/fairwave-control
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/fairwave /etc/fairwave
PrivateTmp=true
PrivateDevices=true
# TX invariance: the service has no RF access beyond what the control plane
# arms through the RF gate; the node itself stays rfkill-blocked.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
