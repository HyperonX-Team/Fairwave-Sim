{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fairwave.hyperonx.io/schemas/fairwave-control.json",
  "title": "fairwave-control configuration",
  "type": "object",
  "properties": {
    "core": { "type": "string", "enum": ["open5gs", "free5gc"], "default": "open5gs" },
    "server": {
      "type": "object",
      "properties": {
        "listen": { "type": "string", "default": ":8080" },
        "data_dir": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "enum": ["lab", "rf"] },
        "country": { "type": "string", "minLength": 2 },
        "log_level": { "type": "string", "enum": ["trace", "debug", "info", "warn", "error"] },
        "log_format": { "type": "string", "enum": ["json", "console"] },
        "shutdown_timeout": { "type": "string" }
      },
      "required": ["mode", "country"],
      "additionalProperties": false
    },
    "plmn": {
      "type": "object",
      "properties": {
        "mcc": { "type": "string", "pattern": "^[0-9]{3}$" },
        "mnc": { "type": "string", "pattern": "^[0-9]{2,3}$" }
      },
      "required": ["mcc", "mnc"],
      "additionalProperties": false
    },
    "tac": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "apns": { "type": "array", "items": { "type": "string" } },
    "spectrum": {
      "type": "object",
      "properties": { "overlay_path": { "type": "string" } },
      "additionalProperties": false
    },
    "auth": {
      "type": "object",
      "properties": {
        "bootstrap_token_ttl": { "type": "string" },
        "admin_token_env": { "type": "string" }
      },
      "additionalProperties": false
    },
    "southbound": {
      "type": "object",
      "properties": {
        "open5gs_config_dir": { "type": "string" },
        "srsran_config_dir": { "type": "string" },
        "driver": { "type": "string", "enum": ["docker", "none"] }
      },
      "additionalProperties": false
    },
    "hss": {
      "type": "object",
      "properties": {
        "driver": { "type": "string", "enum": ["mongosh", "dbctl", "free5gc", "none"] },
        "container": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "peering": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "mdns": { "type": "boolean" },
        "rendezvous": { "type": "string" },
        "wg_iface": { "type": "string" },
        "wg_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "allowed_ips": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "local_breakout": { "type": "boolean" },
        "hub_peer": { "type": "string" },
        "max_ues": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "apns": { "type": "array", "items": { "type": "string" } },
        "qos_dl_mbps": { "type": "integer", "minimum": 0 },
        "qos_ul_mbps": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "metrics": { "type": "boolean" },
        "otlp_endpoint": { "type": "string" },
        "stale_after": { "type": "string" }
      },
      "additionalProperties": false
    },
    "collector": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string" },
        "mme_url": { "type": "string" },
        "smf_url": { "type": "string" },
        "upf": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "iface": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "free5gc": {
      "type": "object",
      "properties": {
        "amf_oam_url": { "type": "string", "minLength": 1 },
        "cdr_dir": { "type": "string" }
      },
      "additionalProperties": false
    },
    "esim": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "registry_path": { "type": "string" },
        "smdp_address": { "type": "string" },
        "smdp_id": { "type": "string" },
        "single_use": { "type": "boolean" },
        "code_ttl": { "type": "string" }
      },
      "additionalProperties": false
    },
    "alerts": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "webhooks": { "type": "array", "items": { "type": "string" } },
        "temp_high_c": { "type": "number" },
        "sim_expiry_warn_days": { "type": "integer", "minimum": 0 },
        "ues_capacity_pct": { "type": "integer", "minimum": 1, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "fairuse": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "usage_interval": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "required": ["server", "plmn", "tac"],
  "additionalProperties": false
}
